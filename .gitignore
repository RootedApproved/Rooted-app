# Dependencies — reinstalled from package.json, never committed
node_modules/

# Generated by scripts/build-www.js from Index.html. A build artifact, not source.
# Index.html at the repo root remains the single source of truth.
www/

# Local build noise
.DS_Store
*.log

# Native project build output. The ios/ and android/ project folders themselves ARE
# committed once generated (they hold signing config and native settings), but their
# build artifacts are not.
ios/App/build/
ios/App/Pods/
android/app/build/
android/build/
android/.gradle/
android/local.properties
__pycache__/
.claude/
